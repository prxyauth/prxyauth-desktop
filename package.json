{
  "name": "electron-prxyauth-client",
  "version": "1.2.3",
  "description": "Electron desktop app for connecting to be-prxyauth Playwright WebSocket server",
  "main": "dist/main/index.js",
  "author": {
    "name": "Lion"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --build tsconfig.main.json && vite build && electron-builder",
    "preview": "vite preview",
    "compile:main": "tsc --build tsconfig.main.json",
    "electron:dev": "tsc --build tsconfig.main.json && concurrently \"vite --port 5180\" \"tsc --build tsconfig.main.json --watch\" \"wait-on http://localhost:5180 && electron .\"",
    "electron:build": "tsc --build tsconfig.main.json && vite build && electron-builder"
  },
  "dependencies": {
    "builder-util-runtime": "^9.5.1",
    "clsx": "^2.1.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "extract-zip": "^2.0.1",
    "framer-motion": "^11.0.8",
    "lucide-react": "^0.344.0",
    "playwright-core": "^1.40.1",
    "proxy-chain": "^2.7.1",
    "qrcode.react": "^4.2.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.19.27",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^28.1.3",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.49",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.prxyauth.electron",
    "productName": "Prxy Auth",
    "copyright": "Copyright © 2026 Lion",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "prxyauth",
      "repo": "prxyauth-desktop"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PRXY Browser"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "icon": "assets/icon.png"
    },
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "assets/icon.png"
    },
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ]
  }
}
